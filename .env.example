# Copy this file to .env.local (local) or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# 1. Database (MongoDB)
#    On your computer (MongoDB installed locally) — use 127.0.0.1, not "localhost":
MONGODB_URI=mongodb://127.0.0.1:27017
#    On Vercel use a free MongoDB Atlas cluster instead, e.g.
#    MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dr_shivam_mishra

# 2. Admin login at /admin
ADMIN_PASSWORD=choose-a-long-password-12-plus-chars
# Generate with:  openssl rand -hex 32   (must be at least 32 characters)
SESSION_SECRET=

# 3. Email alert for every booking (Resend — free tier is enough). Optional but recommended.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
BOOKING_EMAIL_TO=clinic@example.com
# After verifying your domain in Resend, e.g. "Dr. Shivam Mishra <bookings@yourdomain.com>"
BOOKING_EMAIL_FROM=Bookings <onboarding@resend.dev>

# 4. Live site address (used for the "Open admin" link in emails)
NEXT_PUBLIC_SITE_URL=https://dr-shivam-mishra.vercel.app
